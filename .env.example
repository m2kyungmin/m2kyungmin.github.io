# ---- 콘텐츠 자동 생성 (GitHub Secrets 에 등록: ANTHROPIC_API_KEY) ----
ANTHROPIC_API_KEY=
# 기본 claude-opus-5. 비용을 줄이려면 claude-sonnet-5
CLAUDE_MODEL=claude-opus-5

# ---- 수익화 (GitHub Variables 에 등록, 모두 선택사항 / 비우면 해당 요소 미표시) ----
PUBLIC_ADSENSE_CLIENT=            # ca-pub-XXXXXXXXXXXXXXXX
PUBLIC_ADSENSE_SLOT_TOP=          # 광고 단위 ID (숫자)
PUBLIC_ADSENSE_SLOT_BOTTOM=
PUBLIC_ADFIT_UNIT=                # 카카오 애드핏 (애드센스 승인 전 대안)
PUBLIC_COUPANG_ID=                # 쿠팡 파트너스 AF ID
PUBLIC_GA_ID=                     # G-XXXXXXXXXX
PUBLIC_NAVER_VERIFY=              # 네이버 서치어드바이저 소유확인 코드
PUBLIC_GOOGLE_VERIFY=             # 구글 서치콘솔 소유확인 코드
SITE_URL=https://mintech.ai.kr
