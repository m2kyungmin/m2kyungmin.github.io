---
import { offersFor } from "../lib/offers";
import AdDisclosure from "./AdDisclosure.astro";
interface Props { calc?: string; title?: string }
const { calc, title = "함께 확인해 볼 금융 상품" } = Astro.props;
const offers = offersFor(calc);
---
{offers.length > 0 && (
  <aside class="card offers">
    <h3>💳 {title}</h3>
    <AdDisclosure text="이 영역은 제휴마케팅 광고로, 이에 따른 일정액의 수수료를 제공받습니다." />
    <div class="grid">
      {offers.map((o) => (
        <a class="tile" href={o.url} target="_blank" rel="nofollow sponsored noopener"><strong>{o.name}</strong><small>{o.desc}</small><span class="btn small-btn">{o.cta}</span></a>
      ))}
    </div>
    <p class="muted small">이용자에게 추가 비용은 없으며, 상품 조건은 반드시 해당 서비스 안내를 확인하세요.</p>
  </aside>
)}
