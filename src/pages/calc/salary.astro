---
import CalcShell from "../../components/CalcShell.astro";
const faq = [
  { q: "실수령액은 어떻게 계산하나요?", a: "월 급여에서 국민연금(4.5%), 건강보험(3.595%), 장기요양보험(건강보험료의 13.14%), 고용보험(0.9%)과 근로소득세·지방소득세를 뺀 금액입니다. 비과세 항목(식대 등)은 세금과 보험료 계산에서 제외됩니다." },
  { q: "회사에서 받은 명세서와 왜 다른가요?", a: "실제 소득세는 국세청 간이세액표를 기준으로 원천징수되고, 회사마다 비과세 항목·상여 처리 방식이 달라 수만 원 정도 차이가 날 수 있습니다. 이 계산기는 2026년 기준 요율로 산출한 추정치입니다." },
  { q: "부양가족 수는 어떻게 넣나요?", a: "본인을 포함한 기본공제 대상 인원입니다. 혼자라면 1, 배우자와 자녀 1명이 있다면 3을 입력하세요. 만 8세 이상 20세 이하 자녀는 별도로 입력하면 자녀세액공제가 반영됩니다." },
  { q: "연말정산 환급은 반영되나요?", a: "아니요. 이 계산은 매달 원천징수되는 금액 기준입니다. 연말정산에서 각종 공제를 받으면 이미 낸 세금 일부를 돌려받을 수 있습니다." },
];
---
<CalcShell slug="salary" faq={faq} products={["가계부", "직장인 도시락통", "재테크 책"]}>
  <form id="f" onsubmit="return false">
    <label>급여 기준</label>
    <div class="seg">
      <label><input type="radio" name="mode" value="year" checked /><span>연봉</span></label>
      <label><input type="radio" name="mode" value="month" /><span>월급</span></label>
    </div>
    <label for="amount">금액 (원)</label>
    <input type="number" id="amount" value="40000000" min="0" step="100000" inputmode="numeric" />
    <p class="hint" id="amountHint">4,000만원</p>
    <div class="row">
      <div>
        <label for="taxfree">월 비과세액 (원)</label>
        <input type="number" id="taxfree" value="200000" min="0" step="10000" />
        <p class="hint">식대 등. 기본 20만원</p>
      </div>
      <div>
        <label for="family">부양가족 수 (본인 포함)</label>
        <input type="number" id="family" value="1" min="1" max="20" />
      </div>
    </div>
    <div class="row">
      <div>
        <label for="children">8세~20세 자녀 수</label>
        <input type="number" id="children" value="0" min="0" max="10" />
      </div>
      <div>
        <label for="months">퇴직금 포함 여부</label>
        <select id="months">
          <option value="12">별도 (연봉 ÷ 12)</option>
          <option value="13">포함 (연봉 ÷ 13)</option>
        </select>
      </div>
    </div>
    <button class="btn" id="go">실수령액 계산</button>
  </form>
  <div class="result" id="out" hidden>
    <div>월 예상 실수령액</div>
    <div class="big" id="net"></div>
    <div class="muted small">연 실수령액 <strong id="netYear"></strong> · 월 공제 합계 <strong id="ded"></strong></div>
    <table>
      <tr><th>항목</th><th>월 금액</th></tr>
      <tr><td>세전 월급</td><td id="gross"></td></tr>
      <tr><td>국민연금 (4.5%)</td><td id="np"></td></tr>
      <tr><td>건강보험 (3.595%)</td><td id="hi"></td></tr>
      <tr><td>장기요양보험</td><td id="ltc"></td></tr>
      <tr><td>고용보험 (0.9%)</td><td id="ei"></td></tr>
      <tr><td>소득세</td><td id="tax"></td></tr>
      <tr><td>지방소득세</td><td id="ltax"></td></tr>
      <tr class="total"><td>실수령액</td><td id="net2"></td></tr>
    </table>
    <p class="hint">2026년 요율 기준 추정치입니다. 실제 원천징수액은 간이세액표와 회사 규정에 따라 달라질 수 있습니다.</p>
  </div>

  <div slot="guide">
    <h2>연봉 실수령액 계산 방법</h2>
    <p>연봉을 12로 나눈 세전 월급에서 <strong>4대보험료</strong>와 <strong>근로소득세·지방소득세</strong>를 빼면 실수령액이 됩니다. 2026년 근로자 부담 요율은 아래와 같습니다.</p>
    <table>
      <tr><th>항목</th><th>근로자 부담</th><th>비고</th></tr>
      <tr><td>국민연금</td><td>4.5%</td><td>기준소득월액 상한 637만원</td></tr>
      <tr><td>건강보험</td><td>3.595%</td><td>총 7.19%의 절반</td></tr>
      <tr><td>장기요양보험</td><td>건강보험료 × 13.14%</td><td></td></tr>
      <tr><td>고용보험</td><td>0.9%</td><td></td></tr>
      <tr><td>소득세</td><td>6~45% 누진</td><td>간이세액표 기준 원천징수</td></tr>
      <tr><td>지방소득세</td><td>소득세 × 10%</td><td></td></tr>
    </table>
    <h2>연봉별 실수령액 표 (1인 가구, 비과세 20만원 기준)</h2>
    <table id="quick">
      <tr><th>연봉</th><th>월 실수령액</th><th>연봉</th><th>월 실수령액</th></tr>
    </table>
    <p class="hint">위 표는 이 계산기의 동일한 기준으로 자동 산출됩니다.</p>
  </div>

  <script>
    import { calcSalary } from "../../lib/salary";
    import { won, kor } from "../../lib/format";
    const $ = (id) => document.getElementById(id);
    function run(){
      const mode = document.querySelector('input[name=mode]:checked').value;
      const amount = +$("amount").value||0, taxfree=+$("taxfree").value||0, family=Math.max(1,+$("family").value||1), children=+$("children").value||0, div=+$("months").value;
      let annual = mode==="year" ? amount : amount*12;
      const annualTaxable = Math.max(0, annual - taxfree*(mode==="year"?div:12));
      const r = calcSalary(annualTaxable, taxfree, family, children, mode==="year"?div:12);
      $("net").textContent = won(r.net); $("netYear").textContent = won(r.net*12);
      $("ded").textContent = won(r.grossMonthly-r.net);
      $("gross").textContent=won(r.grossMonthly); $("np").textContent=won(r.np); $("hi").textContent=won(r.hi); $("ltc").textContent=won(r.ltc); $("ei").textContent=won(r.ei); $("tax").textContent=won(r.tax); $("ltax").textContent=won(r.ltax); $("net2").textContent=won(r.net);
      $("out").hidden=false;
    }
    // /calc/salary?amount=40000000 형태로 진입하면 값 미리 채움 (연봉별 페이지에서 링크)
    const qa = new URLSearchParams(location.search).get("amount");
    if (qa && +qa > 0) $("amount").value = String(+qa);
    $("go").addEventListener("click", run);
    $("amount").addEventListener("input", ()=>{ $("amountHint").textContent = kor(+$("amount").value||0); });
    $("amountHint").textContent = kor(+$("amount").value||0);
    document.querySelectorAll('input[name=mode]').forEach(el=>el.addEventListener("change",()=>{ const m=el.value; if(!el.checked)return; $("amount").value = m==="year"? 40000000 : 3000000; $("amountHint").textContent=kor(+$("amount").value); }));
    // 빠른 참조 표
    const rows=[]; for(let y=2.4e7;y<=1.2e8;y+=(y<6e7?4e6:1e7)) rows.push(y);
    const q=$("quick"); for(let i=0;i<rows.length;i+=2){ const tr=document.createElement("tr"); [rows[i],rows[i+1]].forEach(y=>{ if(!y){tr.innerHTML+="<td></td><td></td>";return;} const r=calcSalary(y-2.4e6,200000,1,0,12); tr.innerHTML+=`<td><a href="/salary/${y/1e4}">${kor(y)}</a></td><td>${won(r.net)}</td>`; }); q.appendChild(tr); }
    run();
  </script>
</CalcShell>
