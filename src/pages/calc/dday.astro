---
import CalcShell from "../../components/CalcShell.astro";
const faq = [
  { q: "D-day를 계산할 때 오늘은 포함되나요?", a: "이 계산기는 목표일 탭에서 '오늘부터 목표일까지 남은 날수'를 기준으로 D-N을 표시합니다. 오늘이 목표일이면 D-DAY로 표시됩니다." },
  { q: "100일, 200일 기념일은 만난 날을 포함해서 세나요?", a: "관례적으로 만난 날을 1일차로 포함해서 세는 경우가 많습니다. '두 날짜 사이' 탭의 '시작일 포함' 옵션을 체크하면 시작일을 1일차로 포함해서 계산하고, 해제하면 두 날짜의 순수한 차이만 계산합니다." },
  { q: "군대 전역일까지 남은 기간도 계산할 수 있나요?", a: "네, '목표일까지' 탭에 전역일을 입력하면 남은 일수와 주·개월 환산 값을 확인할 수 있습니다." },
  { q: "날짜 계산에 시간대 오류는 없나요?", a: "이 계산기는 연·월·일 단위로만 날짜를 다루고 자정 기준으로 비교하기 때문에, 시간대나 서머타임으로 인한 하루 오차가 발생하지 않습니다." },
  { q: "특정 날짜로부터 정확히 며칠 전 날짜도 구할 수 있나요?", a: "네, 'N일 후/전' 탭에서 일수에 음수를 입력하면 기준일로부터 그만큼 이전 날짜와 요일을 계산해 드립니다." },
];
---
<CalcShell slug="dday" faq={faq} products={["탁상 캘린더", "다이어리", "스터디 플래너"]}>
  <form id="f" onsubmit="return false">
    <div class="seg">
      <label><input type="radio" name="tab" value="target" checked /><span>목표일까지</span></label>
      <label><input type="radio" name="tab" value="between" /><span>두 날짜 사이</span></label>
      <label><input type="radio" name="tab" value="after" /><span>N일 후/전</span></label>
    </div>

    <div id="tabTarget">
      <label for="targetDate">목표 날짜</label>
      <input type="date" id="targetDate" />
    </div>

    <div id="tabBetween" hidden>
      <div class="row">
        <div><label for="startDate">시작일</label><input type="date" id="startDate" /></div>
        <div><label for="endDate">종료일</label><input type="date" id="endDate" /></div>
      </div>
      <label style="display:flex;align-items:center;gap:6px;font-weight:500;margin-top:10px">
        <input type="checkbox" id="includeStart" checked style="width:auto" /> 시작일을 1일차로 포함
      </label>
    </div>

    <div id="tabAfter" hidden>
      <div class="row">
        <div><label for="baseDate">기준일</label><input type="date" id="baseDate" /></div>
        <div><label for="offsetDays">일수 (음수 입력 시 이전)</label><input type="number" id="offsetDays" value="100" /></div>
      </div>
      <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:10px">
        <button type="button" class="quick" data-n="100" style="flex:1;min-width:70px;padding:9px;border:1px solid #cbd5e1;border-radius:8px;background:#fff;cursor:pointer;font-weight:500">100일</button>
        <button type="button" class="quick" data-n="200" style="flex:1;min-width:70px;padding:9px;border:1px solid #cbd5e1;border-radius:8px;background:#fff;cursor:pointer;font-weight:500">200일</button>
        <button type="button" class="quick" data-n="365" style="flex:1;min-width:70px;padding:9px;border:1px solid #cbd5e1;border-radius:8px;background:#fff;cursor:pointer;font-weight:500">365일</button>
        <button type="button" class="quick" data-n="1000" style="flex:1;min-width:70px;padding:9px;border:1px solid #cbd5e1;border-radius:8px;background:#fff;cursor:pointer;font-weight:500">1000일</button>
      </div>
    </div>

    <button class="btn" id="go">계산하기</button>
  </form>

  <div class="result" id="out" hidden>
    <div id="outTarget">
      <div>목표일까지</div>
      <div class="big" id="dday"></div>
      <div class="muted small" id="targetDetail"></div>
    </div>
    <div id="outBetween" hidden>
      <div>두 날짜 사이</div>
      <div class="big" id="betweenDays"></div>
      <div class="muted small" id="betweenDetail"></div>
    </div>
    <div id="outAfter" hidden>
      <div id="afterLabel">계산된 날짜</div>
      <div class="big" id="afterDate"></div>
      <div class="muted small" id="afterDetail"></div>
    </div>
  </div>

  <div slot="guide">
    <h2>100일 계산, 당일을 포함해야 할까요?</h2>
    <p>연인의 100일, 200일 같은 기념일은 관례적으로 만난 날을 1일차로 포함해서 세는 경우가 일반적입니다. 예를 들어 1월 1일에 만났다면 100일째는 4월 9일이 됩니다(1월 1일을 1일차로 계산). '두 날짜 사이' 탭의 '시작일 포함' 옵션으로 두 방식을 모두 확인할 수 있습니다.</p>
    <h2>D-day 활용 예시</h2>
    <table>
      <tr><th>용도</th><th>기준일 예시</th><th>활용 팁</th></tr>
      <tr><td>커플 기념일</td><td>처음 만난 날</td><td>시작일 포함 옵션으로 100일·200일·1000일 확인</td></tr>
      <tr><td>군 전역일</td><td>입대일 + 복무기간</td><td>'목표일까지' 탭에 전역 예정일을 입력해 D-day 확인</td></tr>
      <tr><td>시험 D-day</td><td>시험 당일</td><td>'목표일까지' 탭으로 남은 주·일수를 확인해 학습 계획 수립</td></tr>
      <tr><td>여행·이사 준비</td><td>출발일·입주일</td><td>'N일 후/전' 탭으로 준비 마감일 역산</td></tr>
    </table>
    <p class="hint">모든 계산은 연·월·일 단위로만 처리되어 시간대 오차 없이 정확한 날짜를 보여드립니다.</p>
  </div>

  <script>
    const $ = (id) => document.getElementById(id);
    const pad = (n) => String(n).padStart(2, "0");
    const WD = ["일", "월", "화", "수", "목", "금", "토"];
    function toISO(d) { return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`; }
    function parseDateInput(str) { const [y, m, d] = str.split("-").map(Number); return new Date(y, (m || 1) - 1, d || 1); }
    function addDays(d, n) { return new Date(d.getFullYear(), d.getMonth(), d.getDate() + n); }
    function diffDays(a, b) { return Math.round((b - a) / 86400000); }
    function fmtDate(d) { return `${d.getFullYear()}.${pad(d.getMonth() + 1)}.${pad(d.getDate())} (${WD[d.getDay()]})`; }

    const today = new Date(); today.setHours(0, 0, 0, 0);
    $("targetDate").value = toISO(addDays(today, 100));
    $("startDate").value = toISO(today);
    $("endDate").value = toISO(addDays(today, 30));
    $("baseDate").value = toISO(today);

    function run() {
      const tab = document.querySelector('input[name=tab]:checked').value;
      if (tab === "target") {
        const d = parseDateInput($("targetDate").value);
        const diff = diffDays(today, d);
        const abs = Math.abs(diff);
        $("dday").textContent = diff === 0 ? "D-DAY" : diff > 0 ? `D-${diff}` : `D+${abs}`;
        const weeks = Math.floor(abs / 7);
        const months = Math.floor(abs / 30);
        $("targetDetail").textContent = `${fmtDate(d)} · 약 ${weeks}주 ${abs % 7}일 (약 ${months}개월) ${diff >= 0 ? "남음" : "지남"}`;
      } else if (tab === "between") {
        const s = parseDateInput($("startDate").value);
        const e = parseDateInput($("endDate").value);
        const includeStart = $("includeStart").checked;
        const days = diffDays(s, e) + (includeStart ? 1 : 0);
        const abs = Math.abs(days);
        $("betweenDays").textContent = `${days.toLocaleString("ko-KR")}일`;
        const weeks = Math.floor(abs / 7);
        const y = Math.floor(abs / 365), remM = Math.floor((abs % 365) / 30), remD = (abs % 365) % 30;
        $("betweenDetail").textContent = `${fmtDate(s)} ~ ${fmtDate(e)} · 약 ${weeks}주 · 약 ${y}년 ${remM}개월 ${remD}일`;
      } else {
        const b = parseDateInput($("baseDate").value);
        const n = Math.round(+$("offsetDays").value || 0);
        const d = addDays(b, n);
        $("afterLabel").textContent = n >= 0 ? `${n}일 후` : `${Math.abs(n)}일 전`;
        $("afterDate").textContent = fmtDate(d);
        $("afterDetail").textContent = `${fmtDate(b)} 기준 ${n >= 0 ? "+" : ""}${n}일`;
      }
      $("out").hidden = false;
    }

    document.querySelectorAll('input[name=tab]').forEach((el) => el.addEventListener("change", () => {
      if (!el.checked) return;
      const t = el.value;
      $("tabTarget").hidden = t !== "target";
      $("tabBetween").hidden = t !== "between";
      $("tabAfter").hidden = t !== "after";
      $("outTarget").hidden = t !== "target";
      $("outBetween").hidden = t !== "between";
      $("outAfter").hidden = t !== "after";
      run();
    }));

    $("go").addEventListener("click", run);
    $("targetDate").addEventListener("input", run);
    $("startDate").addEventListener("input", run);
    $("endDate").addEventListener("input", run);
    $("includeStart").addEventListener("change", run);
    $("baseDate").addEventListener("input", run);
    $("offsetDays").addEventListener("input", run);
    document.querySelectorAll(".quick").forEach((btn) => btn.addEventListener("click", () => {
      $("offsetDays").value = btn.dataset.n;
      run();
    }));

    run();
  </script>
</CalcShell>
