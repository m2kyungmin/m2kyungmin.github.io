---
import CalcShell from "../../components/CalcShell.astro";
const faq = [
  { q: "퇴직금은 누구나 받을 수 있나요?", a: "같은 사업장에서 계속근로기간 1년 이상, 4주 평균 1주 소정근로시간이 15시간 이상인 근로자에게 지급됩니다. 정규직·계약직·아르바이트 구분 없이 조건만 충족하면 받을 수 있습니다." },
  { q: "평균임금과 통상임금은 뭐가 다른가요?", a: "평균임금은 퇴직 전 3개월간 받은 임금 총액을 그 기간의 총일수로 나눈 금액이고, 통상임금은 소정근로에 대해 정기적·일률적으로 지급하기로 정해진 시급·월급입니다. 평균임금이 통상임금보다 적게 계산되면 통상임금을 평균임금으로 봅니다." },
  { q: "상여금과 연차수당도 퇴직금에 포함되나요?", a: "네. 최근 1년간 지급된 상여금의 3/12과 연차수당의 3/12에 해당하는 금액이 평균임금 산정에 포함됩니다." },
  { q: "퇴직소득세는 어떻게 계산되나요?", a: "근속연수공제와 환산급여공제를 적용해 과세표준을 줄인 뒤 6~45% 누진세율을 적용합니다. 근속연수가 길수록 공제가 커져 실효세율이 낮아지는 구조입니다." },
  { q: "IRP로 받으면 세금이 달라지나요?", a: "퇴직금을 IRP(개인형 퇴직연금) 계좌로 받으면 퇴직소득세 납부가 연금 수령 시점까지 이연되고, 연금으로 나눠 받으면 세율이 30~40% 감면됩니다." },
];
---
<CalcShell slug="severance" faq={faq} products={["IRP 계좌 개설 안내서", "재테크 다이어리", "노트북 파우치"]}>
  <form id="f" onsubmit="return false">
    <div class="row">
      <div>
        <label for="hireDate">입사일</label>
        <input type="date" id="hireDate" value="2023-09-13" />
      </div>
      <div>
        <label for="resignDate">퇴사일</label>
        <input type="date" id="resignDate" value="2026-09-13" />
      </div>
    </div>
    <label for="pay3m">최근 3개월 총급여 (원)</label>
    <input type="number" id="pay3m" value="9000000" min="0" step="10000" inputmode="numeric" />
    <p class="hint">세전 기준. 월급이 300만원이면 3개월 합계 900만원을 입력하세요.</p>
    <div class="row">
      <div>
        <label for="bonus">최근 1년 상여금 합계 (원)</label>
        <input type="number" id="bonus" value="0" min="0" step="10000" />
      </div>
      <div>
        <label for="annualLeavePay">최근 1년 연차수당 (원)</label>
        <input type="number" id="annualLeavePay" value="0" min="0" step="10000" />
      </div>
    </div>
    <button class="btn" id="go">퇴직금 계산하기</button>
  </form>
  <div class="result" id="out" hidden>
    <div>예상 퇴직금 (세전)</div>
    <div class="big" id="gross"></div>
    <div class="muted small">재직기간 <strong id="period"></strong> · 세후 예상액 <strong id="net"></strong></div>
    <table>
      <tr><th>항목</th><th>금액</th></tr>
      <tr><td>1일 평균임금</td><td id="avgWage"></td></tr>
      <tr><td>재직일수</td><td id="totalDays"></td></tr>
      <tr class="total"><td>퇴직금 (세전)</td><td id="gross2"></td></tr>
      <tr><td>퇴직소득세</td><td id="incomeTax"></td></tr>
      <tr><td>지방소득세</td><td id="localTax"></td></tr>
      <tr class="total"><td>세후 예상 수령액</td><td id="net2"></td></tr>
    </table>
    <p class="hint" id="warn"></p>
    <p class="hint">평균임금이 통상임금(시급×소정근로시간 기준)보다 낮게 산출되면 실제로는 통상임금이 적용되어 금액이 달라질 수 있습니다. 세후 금액은 단순 추정치입니다.</p>
  </div>

  <div slot="guide">
    <h2>퇴직금 지급 조건</h2>
    <p>퇴직금은 <strong>계속근로기간 1년 이상</strong>, <strong>4주 평균 1주 소정근로시간 15시간 이상</strong>인 근로자가 퇴직할 때 사용자가 지급해야 합니다. 법정 최소 기준은 계속근로연수 1년에 대해 30일분 이상의 평균임금입니다.</p>
    <table>
      <tr><th>항목</th><th>계산식</th></tr>
      <tr><td>1일 평균임금</td><td>(3개월 임금 + 상여금×3/12 + 연차수당×3/12) ÷ 최근 3개월 일수</td></tr>
      <tr><td>퇴직금</td><td>1일 평균임금 × 30일 × (재직일수 ÷ 365)</td></tr>
    </table>
    <h2>평균임금 vs 통상임금</h2>
    <p>평균임금은 실제 받은 임금의 평균이므로 연장·야간근로수당 등 변동급이 반영되어 통상임금보다 높은 것이 보통입니다. 다만 계산 결과가 통상임금보다 낮게 나오면 근로기준법에 따라 통상임금을 평균임금으로 대신 사용합니다.</p>
    <h2>IRP(개인형 퇴직연금) 안내</h2>
    <p>2022년부터 퇴직금은 원칙적으로 근로자의 IRP 계좌로 지급됩니다. IRP로 받으면 퇴직소득세가 연금을 실제로 인출할 때까지 이연되며, 55세 이후 연금 형태로 나눠 받으면 퇴직소득세의 30~40%가 감면된 세율이 적용됩니다.</p>
  </div>

  <script>
    const $ = (id) => document.getElementById(id);
    const won = (n) => Math.round(n).toLocaleString("ko-KR") + "원";
    const DAY = 86400000;

    // 퇴직소득세 누진세율표 (종합소득세율과 동일, 2026년 기준)
    const BR = [[14000000,0.06],[50000000,0.15],[88000000,0.24],[150000000,0.35],[300000000,0.38],[500000000,0.40],[1000000000,0.42],[Infinity,0.45]];
    function progressive(base){ let t=0, prev=0; for(const [lim,rate] of BR){ if(base>prev){ t+=(Math.min(base,lim)-prev)*rate; prev=lim; } else break; } return t; }

    function serviceYearDeduction(n){
      if(n<=5) return 1000000*n;
      if(n<=10) return 5000000+2000000*(n-5);
      if(n<=20) return 15000000+2500000*(n-10);
      return 40000000+3000000*(n-20);
    }
    function conversionDeduction(y){
      if(y<=8000000) return y;
      if(y<=70000000) return 8000000+(y-8000000)*0.6;
      if(y<=100000000) return 45200000+(y-70000000)*0.55;
      if(y<=300000000) return 61700000+(y-100000000)*0.45;
      return 151700000+(y-300000000)*0.35;
    }

    function calendarPeriod(start, end){
      let y = end.getFullYear()-start.getFullYear();
      let m = end.getMonth()-start.getMonth();
      let d = end.getDate()-start.getDate();
      if(d<0){ m--; const prevMonth = new Date(end.getFullYear(), end.getMonth(), 0); d += prevMonth.getDate(); }
      if(m<0){ y--; m+=12; }
      return { y, m, d };
    }

    function run(){
      const hire = new Date($("hireDate").value);
      const resign = new Date($("resignDate").value);
      const pay3m = +$("pay3m").value || 0;
      const bonus = +$("bonus").value || 0;
      const leave = +$("annualLeavePay").value || 0;

      if(isNaN(hire.getTime()) || isNaN(resign.getTime()) || resign <= hire){
        $("warn").textContent = "퇴사일은 입사일보다 이후여야 합니다.";
        return;
      }

      const totalDays = Math.round((resign - hire)/DAY);
      const threeMonthsAgo = new Date(resign);
      threeMonthsAgo.setMonth(threeMonthsAgo.getMonth()-3);
      const days3m = Math.max(1, Math.round((resign - threeMonthsAgo)/DAY));

      const avgWage = (pay3m + bonus*3/12 + leave*3/12) / days3m;
      const gross = avgWage * 30 * (totalDays/365);

      const { y, m, d } = calendarPeriod(hire, resign);
      $("period").textContent = `${y}년 ${m}개월 ${d}일`;
      $("warn").textContent = totalDays < 365
        ? "재직기간이 1년 미만이면 법적으로 퇴직금 지급 의무가 없습니다. 참고용 금액입니다."
        : "";

      // 퇴직소득세 (근속연수는 1년 미만 절상)
      const serviceYears = Math.max(1, Math.ceil(totalDays/365));
      const syDeduction = serviceYearDeduction(serviceYears);
      const converted = Math.max(0, (gross - syDeduction) / serviceYears * 12);
      const cDeduction = conversionDeduction(converted);
      const taxBase = Math.max(0, converted - cDeduction);
      const convertedTax = progressive(taxBase);
      const incomeTax = Math.max(0, convertedTax / 12 * serviceYears);
      const localTax = incomeTax * 0.1;
      const net = gross - incomeTax - localTax;

      $("gross").textContent = won(gross);
      $("gross2").textContent = won(gross);
      $("net").textContent = won(net);
      $("net2").textContent = won(net);
      $("avgWage").textContent = won(avgWage);
      $("totalDays").textContent = totalDays.toLocaleString("ko-KR") + "일";
      $("incomeTax").textContent = won(incomeTax);
      $("localTax").textContent = won(localTax);
      $("out").hidden = false;
    }

    $("go").addEventListener("click", run);
    ["hireDate","resignDate","pay3m","bonus","annualLeavePay"].forEach((id) => $(id).addEventListener("input", run));
    run();
  </script>
</CalcShell>
