---
import Base from "../../layouts/Base.astro";
import AdSlot from "../../components/AdSlot.astro";
import Coupang from "../../components/Coupang.astro";
import { weeklyPay, MIN_WAGE_2026 } from "../../lib/finance";
import { won, kor, num } from "../../lib/format";
import { getCollection } from "astro:content";

const YEAR = 2026;

// 시급 9,000~13,000원은 100원 단위, 13,000~20,000원은 500원 단위. 2026년 최저시급(10,320원) 포함.
export const WAGES = Array.from(
  new Set([
    ...Array.from({ length: 41 }, (_, i) => 9000 + i * 100),
    ...Array.from({ length: 15 }, (_, i) => 13000 + i * 500),
    MIN_WAGE_2026,
  ])
).sort((a, b) => a - b);

export async function getStaticPaths() {
  return WAGES.map((w) => ({ params: { wage: String(w) } }));
}

const wage = Number(Astro.params.wage);
const base = weeklyPay(wage, 8, 5, 0); // 주 40시간(8시간×5일) 기준

const title = `시급 ${num(wage)}원 월급 (${YEAR}년) 주휴수당 포함 약 ${kor(base.monthly)}`;
const description = `시급 ${num(wage)}원을 주 40시간(8시간×5일) 근무 기준으로 계산하면 주휴수당 포함 월급은 약 ${won(base.monthly)}, 연봉 환산 약 ${won(base.annual)}입니다. 주 근무시간별·연장근로 포함 월급까지 표로 정리했습니다.`;

const idx = WAGES.indexOf(wage);
const neighbors = WAGES.slice(Math.max(0, idx - 5), idx).concat(WAGES.slice(idx + 1, idx + 6));

const hourRows = [15, 20, 25, 30, 35, 40].map((h) => {
  const withHoliday = weeklyPay(wage, h, 1, 0); // 주 h시간 근무(요일 배분 무관)
  const noHolidayWeekly = wage * h;
  return {
    h,
    withHolidayMonthly: withHoliday.monthly,
    noHolidayMonthly: noHolidayWeekly * 4.345,
  };
});

const otRows = [5, 10].map((ot) => {
  const r = weeklyPay(wage, 40, 1, ot);
  return { ot, ...r };
});

const posts = (await getCollection("blog")).filter((p) => p.data.calc === "hourly").sort((a, b) => +b.data.pubDate - +a.data.pubDate).slice(0, 4);

const faq = [
  { q: `시급 ${num(wage)}원이면 한 달에 얼마를 받나요?`, a: `주 40시간(하루 8시간, 주 5일) 근무 기준으로 주휴수당을 포함하면 월급은 약 ${won(base.monthly)}입니다. 연장근로나 근무시간이 다르면 금액이 달라집니다.` },
  { q: "주휴수당은 항상 받을 수 있나요?", a: "1주 소정근로시간이 15시간 이상이고 그 주에 결근 없이 개근했을 때만 지급됩니다. 주 15시간 미만으로 근무하면 주휴수당 지급 대상이 아닙니다." },
  { q: "이 계산 결과에 4대보험이나 세금이 빠져 있나요?", a: "네, 위 금액은 세전 금액입니다. 4대보험료와 소득세를 제외한 실수령액이 궁금하다면 연봉 실수령액 계산기를 함께 활용해 보세요." },
];
const jsonLd = [
  { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) },
  { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [
    { "@type": "ListItem", position: 1, name: "홈", item: new URL("/", Astro.site).toString() },
    { "@type": "ListItem", position: 2, name: "시급별 월급", item: new URL("/hourly", Astro.site).toString() },
    { "@type": "ListItem", position: 3, name: `시급 ${num(wage)}원`, item: new URL(`/hourly/${wage}`, Astro.site).toString() },
  ] },
];
---
<Base title={title} description={description} keywords={[`시급 ${num(wage)}원 월급`, `시급 ${num(wage)} 계산`, "주휴수당 계산기", "알바 월급"]} jsonLd={jsonLd}>
  <nav class="crumbs"><a href="/">홈</a> › <a href="/hourly">시급별 월급</a> › 시급 {num(wage)}원</nav>
  <h1>시급 {num(wage)}원 월급 ({YEAR}년 기준)</h1>
  <p class="lead">시급 {num(wage)}원으로 주 40시간(하루 8시간 × 주 5일) 근무하면, 주휴수당을 포함한 월급은 <strong>약 {won(base.monthly)}</strong>입니다. 연봉으로 환산하면 약 {won(base.annual)}입니다.</p>
  <AdSlot position="top" />
  <div class="result">
    <div>월급 (주휴수당 포함, 세전)</div>
    <div class="big">{won(base.monthly)}</div>
    <div class="muted small">주급 {won(base.weekly)} · 연봉 환산 {won(base.annual)}</div>
    <table>
      <tr><th>항목</th><th>금액</th></tr>
      <tr><td>기본급 (시급 × 주 40시간)</td><td>{won(base.basePay)}</td></tr>
      <tr><td>주휴수당</td><td>{won(base.holidayPay)}</td></tr>
      <tr class="total"><td>주급</td><td>{won(base.weekly)}</td></tr>
      <tr><td>월급 (주급 × 4.345)</td><td>{won(base.monthly)}</td></tr>
      <tr><td>연봉 환산</td><td>{won(base.annual)}</td></tr>
    </table>
  </div>
  <p class="card">🧮 근무일수·연장근로시간을 바꿔서 내 조건으로 계산하려면 → <a href={`/calc/hourly?wage=${wage}`}><strong>시급·주휴수당 계산기</strong></a></p>

  <section class="prose">
    <h2>주 근무시간별 시급 {num(wage)}원 월급</h2>
    <p>주 소정근로시간이 15시간 이상이면 주휴수당 지급 대상입니다. 근무시간이 늘어날수록 주휴수당(최대 8시간분)도 함께 늘어납니다.</p>
    <table>
      <tr><th>주 근무시간</th><th>주휴수당 포함 월급</th><th>주휴수당 미포함 월급</th></tr>
      {hourRows.map((r) => <tr><td>{r.h}시간</td><td><strong>{won(r.withHolidayMonthly)}</strong></td><td>{won(r.noHolidayMonthly)}</td></tr>)}
    </table>
    <h2>연장근로 포함 시 시급 {num(wage)}원 월급 (주 40시간 기준)</h2>
    <p>연장근로는 통상시급의 1.5배로 계산합니다. 주 40시간 근무에 연장근로를 더한 경우입니다.</p>
    <table>
      <tr><th>연장근로</th><th>연장근로수당</th><th>월급 (주휴수당 포함)</th></tr>
      <tr><td>없음</td><td>-</td><td>{won(base.monthly)}</td></tr>
      {otRows.map((r) => <tr><td>주 {r.ot}시간</td><td>{won(r.overtimePay * 4.345)}</td><td><strong>{won(r.monthly)}</strong></td></tr>)}
    </table>
    <p class="hint">모든 금액은 세전 기준이며, 4대보험료·소득세는 포함되어 있지 않습니다. {YEAR}년 최저시급은 시간당 {num(MIN_WAGE_2026)}원입니다.</p>
  </section>

  <section class="prose">
    <h2>자주 묻는 질문</h2>
    {faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
  </section>
  <AdSlot position="bottom" />
  <Coupang keywords={["알바 앞치마", "근무 기록 노트"]} />

  <section>
    <h2>비슷한 시급 월급</h2>
    <ul class="chips">
      {neighbors.map((w) => <li><a href={`/hourly/${w}`}>시급 {num(w)}원</a></li>)}
    </ul>
    <p><a href="/hourly">시급별 월급 전체 표 →</a></p>
  </section>
  {posts.length > 0 && (
    <section>
      <h2>관련 글</h2>
      <ul class="list">{posts.map((p) => <li><a href={`/blog/${p.id}`}>{p.data.title}</a></li>)}</ul>
    </section>
  )}
</Base>
