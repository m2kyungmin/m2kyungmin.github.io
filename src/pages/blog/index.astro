---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";
const posts = (await getCollection("blog")).sort((a, b) => +b.data.pubDate - +a.data.pubDate);
---
<Base title="블로그" description="연봉, 세금, 대출, 저축 등 돈과 관련된 실용 정보를 쉽게 정리한 글 모음.">
  <h1>블로그</h1>
  {posts.length === 0 && <p class="muted">아직 발행된 글이 없습니다. 매일 새 글이 자동으로 올라옵니다.</p>}
  <ul class="list">
    {posts.map((p) => (
      <li>
        <a href={`/blog/${p.id}`}><strong>{p.data.title}</strong></a>
        <div class="post-meta">{p.data.pubDate.toISOString().slice(0, 10)} · {p.data.tags.join(", ")}</div>
        <div class="muted small">{p.data.description}</div>
      </li>
    ))}
  </ul>
</Base>
