---
import Base from "../../layouts/Base.astro";
import AdSlot from "../../components/AdSlot.astro";
import Coupang from "../../components/Coupang.astro";
import { installmentInterest, depositInterest, afterTax } from "../../lib/finance";
import { won, kor, num } from "../../lib/format";
import { getCollection } from "astro:content";

const YEAR = 2026;

// 월 적금액(만원 단위)
export const MONTHLY = [5, 10, 20, 30, 50, 70, 100, 150, 200];

export async function getStaticPaths() {
  return MONTHLY.map((m) => ({ params: { monthly: String(m) } }));
}

const monthlyMan = Number(Astro.params.monthly);
const monthlyWon = monthlyMan * 10000;
const RATE_DEFAULT = 3.5;
const TAX_RATE = 0.154;

const headlineTerms = [12, 36, 60, 120]; // 1/3/5/10년
const headlineRows = headlineTerms.map((m) => {
  const interest = installmentInterest(monthlyWon, RATE_DEFAULT, m);
  const { tax, net } = afterTax(interest, TAX_RATE);
  const principal = monthlyWon * m;
  return { months: m, principal, interest, tax, net, total: principal + net };
});
const headline = headlineRows[0]; // 1년 기준 대표값

const title = `매달 ${num(monthlyMan)}만원 적금 (${YEAR}년) 1년·3년·5년·10년 만기 수령액`;
const description = `매달 ${num(monthlyMan)}만원씩 연 ${RATE_DEFAULT}% 적금에 납입하면 1년 만기 세후 수령액은 약 ${won(headline.total)}입니다. 기간·금리별 세후 만기 수령액과 예금과의 이자 차이까지 표로 정리했습니다.`;

const RATES = [2.5, 3.0, 3.5, 4.0, 5.0];
const PERIODS = [6, 12, 24, 36, 60, 120];
const mainRows = PERIODS.map((m) => ({
  m,
  cols: RATES.map((rate) => {
    const interest = installmentInterest(monthlyWon, rate, m);
    const { net } = afterTax(interest, TAX_RATE);
    return monthlyWon * m + net;
  }),
}));

const detailCases = [
  { label: "연 3.0%, 12개월", rate: 3.0, months: 12 },
  { label: "연 3.0%, 36개월", rate: 3.0, months: 36 },
].map((c) => {
  const interest = installmentInterest(monthlyWon, c.rate, c.months);
  const { tax, net } = afterTax(interest, TAX_RATE);
  return { ...c, principal: monthlyWon * c.months, interest, tax, net };
});

// 같은 총액을 처음부터 정기예금(단리)에 넣었을 때와 비교 (1년 기준)
const depositCompareMonths = 12;
const depositPrincipal = monthlyWon * depositCompareMonths;
const depositInterestAmt = depositInterest(depositPrincipal, RATE_DEFAULT, depositCompareMonths, false);
const depositNet = afterTax(depositInterestAmt, TAX_RATE).net;
const savingsInterestAmt = installmentInterest(monthlyWon, RATE_DEFAULT, depositCompareMonths);
const savingsNet = afterTax(savingsInterestAmt, TAX_RATE).net;

const neighbors = MONTHLY.filter((m) => m !== monthlyMan);

const posts = (await getCollection("blog")).filter((p) => p.data.calc === "compound").sort((a, b) => +b.data.pubDate - +a.data.pubDate).slice(0, 4);

const faq = [
  { q: `매달 ${num(monthlyMan)}만원씩 1년 적금을 넣으면 얼마를 받나요?`, a: `연 ${RATE_DEFAULT}% 기준으로 원금 ${won(headline.principal)}에 세후 이자 ${won(headline.net)}를 더해 약 ${won(headline.total)}을 받습니다. 금리에 따라 금액이 달라지니 위 표를 참고하세요.` },
  { q: "적금 이자는 왜 예금보다 적게 느껴지나요?", a: "적금은 매월 납입한 돈이 만기까지 남은 기간만큼만 이자를 받는 단리 방식이라, 같은 금액을 처음부터 예치하는 예금보다 실효 이자가 적습니다. 같은 총액 기준으로 비교하면 예금 세후 이자는 약 " + won(depositNet) + "이지만 적금은 약 " + won(savingsNet) + "입니다(1년 기준)." },
  { q: "이자소득세는 얼마나 떼나요?", a: "일반과세 기준 이자소득세 14%와 지방소득세 1.4%를 더한 15.4%가 원천징수됩니다. 세금우대(9.5%)나 비과세종합저축(0%) 상품을 이용하면 세후 수령액이 늘어납니다." },
];
const jsonLd = [
  { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) },
  { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [
    { "@type": "ListItem", position: 1, name: "홈", item: new URL("/", Astro.site).toString() },
    { "@type": "ListItem", position: 2, name: "월 적금액별 만기 수령액", item: new URL("/savings", Astro.site).toString() },
    { "@type": "ListItem", position: 3, name: `매달 ${num(monthlyMan)}만원`, item: new URL(`/savings/${monthlyMan}`, Astro.site).toString() },
  ] },
];
---
<Base title={title} description={description} keywords={[`적금 ${monthlyMan}만원 만기`, `매달 ${monthlyMan}만원 적금`, "적금 이자 계산기", "적금 만기 수령액"]} jsonLd={jsonLd}>
  <nav class="crumbs"><a href="/">홈</a> › <a href="/savings">월 적금액별 만기 수령액</a> › 매달 {num(monthlyMan)}만원</nav>
  <h1>매달 {num(monthlyMan)}만원 적금 ({YEAR}년 기준) 만기 수령액</h1>
  <p class="lead">매달 {num(monthlyMan)}만원씩 연 {RATE_DEFAULT}% 적금에 납입하면 1년 만기 세후 수령액은 <strong>약 {won(headline.total)}</strong>입니다. 아래에서 1년·3년·5년·10년 만기 금액을 함께 확인하세요.</p>
  <AdSlot position="top" />
  <div class="result">
    <div>1년 만기 세후 수령액 (연 {RATE_DEFAULT}%)</div>
    <div class="big">{won(headline.total)}</div>
    <div class="muted small">원금 {won(headline.principal)} · 세후 이자 {won(headline.net)}</div>
    <table>
      <tr><th>기간</th><th>원금</th><th>세후 이자</th><th>세후 만기 수령액</th></tr>
      {headlineRows.map((r) => <tr><td>{r.months / 12}년 ({r.months}개월)</td><td>{won(r.principal)}</td><td>{won(r.net)}</td><td><strong>{won(r.total)}</strong></td></tr>)}
    </table>
  </div>
  <p class="card">🧮 금리·과세 구분을 바꿔서 내 조건으로 계산하려면 → <a href={`/calc/compound?monthly=${monthlyWon}`}><strong>예적금·복리 계산기</strong></a></p>

  <section class="prose">
    <h2>기간·금리별 매달 {num(monthlyMan)}만원 적금 세후 만기 수령액</h2>
    <p>이자소득세 15.4%를 뗀 세후 금액입니다. 정기적금은 매월 납입액마다 남은 기간만큼만 이자가 붙는 단리 방식으로 계산합니다.</p>
    <div class="sched">
      <table>
        <tr><th>기간</th>{RATES.map((rate) => <th>연 {rate}%</th>)}</tr>
        {mainRows.map((row) => (
          <tr>
            <td>{row.m}개월</td>
            {row.cols.map((v) => <td>{won(v)}</td>)}
          </tr>
        ))}
      </table>
    </div>
    <h2>세전·세후 이자 상세 (연 3.0% 기준)</h2>
    <table>
      <tr><th>기간</th><th>원금</th><th>세전 이자</th><th>이자소득세 (15.4%)</th><th>세후 이자</th></tr>
      {detailCases.map((c) => <tr><td>{c.months}개월</td><td>{won(c.principal)}</td><td>{won(c.interest)}</td><td>-{won(c.tax)}</td><td><strong>{won(c.net)}</strong></td></tr>)}
    </table>
    <h2>같은 금액을 예금에 넣었다면? (1년, 연 {RATE_DEFAULT}% 기준)</h2>
    <p>총 {won(depositPrincipal)}을 매달 나눠 적금에 넣으면 세후 이자가 약 {won(savingsNet)}이지만, 처음부터 목돈으로 정기예금에 예치했다면 세후 이자는 약 {won(depositNet)}로 {won(depositNet - savingsNet)} 더 많습니다. 적금은 목돈을 만드는 과정에서 나눠 납입하기 때문에 예금보다 실효 이자가 적을 수밖에 없습니다.</p>
    <p class="hint">계산 결과는 참고용 추정치이며, 실제 상품의 이자 계산 방식(선입선출, 월복리 여부 등)에 따라 금액이 달라질 수 있습니다.</p>
  </section>

  <section class="prose">
    <h2>자주 묻는 질문</h2>
    {faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
  </section>
  <AdSlot position="bottom" />
  <Coupang keywords={["가계부", "재테크 입문 책"]} />

  <section>
    <h2>다른 월 적금액 만기 수령액</h2>
    <ul class="chips">
      {neighbors.map((m) => <li><a href={`/savings/${m}`}>매달 {num(m)}만원</a></li>)}
    </ul>
    <p><a href="/savings">월 적금액별 만기 수령액 전체 표 →</a></p>
  </section>
  {posts.length > 0 && (
    <section>
      <h2>관련 글</h2>
      <ul class="list">{posts.map((p) => <li><a href={`/blog/${p.id}`}>{p.data.title}</a></li>)}</ul>
    </section>
  )}
</Base>
